generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bookings {
  booking_id                         String    @id @db.VarChar(255)
  post_id                            String    @db.VarChar(255)
  bachelor_uid                       String?   @db.VarChar(255)
  landlord_uid                       String?   @db.VarChar(255)
  bachelor_name                      String?   @db.VarChar(255)
  bachelor_phone                     String?   @db.VarChar(20)
  trx_id                             String?   @db.VarChar(100)
  sender_number                      String?   @db.VarChar(20)
  payment_status                     String?   @default("pending") @db.VarChar(50)
  is_unlocked                        Boolean?  @default(false)
  created_at                         DateTime? @default(now()) @db.Timestamp(6)
  updated_at                         DateTime? @default(now()) @db.Timestamp(6)
  users_bookings_bachelor_uidTousers users?    @relation("bookings_bachelor_uidTousers", fields: [bachelor_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  users_bookings_landlord_uidTousers users?    @relation("bookings_landlord_uidTousers", fields: [landlord_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
}

model chats {
  chat_id                      String     @id @db.VarChar(255)
  user1_uid                    String?    @db.VarChar(255)
  user2_uid                    String?    @db.VarChar(255)
  last_message                 String?
  last_message_time            DateTime?  @default(now()) @db.Timestamp(6)
  created_at                   DateTime?  @default(now()) @db.Timestamp(6)
  users_chats_user1_uidTousers users?     @relation("chats_user1_uidTousers", fields: [user1_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  users_chats_user2_uidTousers users?     @relation("chats_user2_uidTousers", fields: [user2_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  messages                     messages[]

  @@index([last_message_time(sort: Desc)], map: "idx_chats_last_time")
  @@index([user1_uid, user2_uid], map: "idx_chats_user1_user2")
}

model messages {
  message_id              Int       @id @default(autoincrement())
  chat_id                 String?   @db.VarChar(255)
  sender_uid              String?   @db.VarChar(255)
  text                    String?
  image_url               String?
  video_url               String?
  is_read                 Boolean?  @default(false)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  reactions               Json?     @default("{}")
  is_deleted              Boolean?  @default(false)
  is_edited               Boolean?  @default(false)
  reply_to_message_id     String?   @db.VarChar(255)
  reply_to_message_text   String?
  reply_to_message_sender String?   @db.VarChar(255)
  chats                   chats?    @relation(fields: [chat_id], references: [chat_id], onDelete: Cascade, onUpdate: NoAction)
  users                   users?    @relation(fields: [sender_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@index([chat_id, created_at], map: "idx_messages_chat_created")
}

model notifications {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  body         String
  type         String?   @db.VarChar(100)
  receiver_uid String    @db.VarChar(255)
  sender_uid   String?   @db.VarChar(255)
  is_read      Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@index([receiver_uid, is_read], map: "idx_notifications_receiver")
}

model password_resets {
  email      String    @id @db.VarChar(255)
  otp        String    @db.VarChar(10)
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model payments {
  payment_id     String    @id @db.VarChar(255)
  user_uid       String?   @db.VarChar(255)
  user_name      String?   @db.VarChar(255)
  user_phone     String?   @db.VarChar(20)
  role           String?   @default("bachelor") @db.VarChar(50)
  amount         Int?      @default(50)
  trx_id         String?   @db.VarChar(100)
  sender_number  String?   @db.VarChar(20)
  payment_method String?   @default("bkash") @db.VarChar(50)
  status         String?   @default("pending") @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users?    @relation(fields: [user_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
}

model posts {
  post_id          Int       @id @default(autoincrement())
  owner_uid        String?   @db.VarChar(255)
  title            String    @db.VarChar(255)
  rent             Decimal   @db.Decimal(10, 2)
  address          String
  latitude         Decimal?  @default(23.8103) @db.Decimal(10, 6)
  longitude        Decimal?  @default(90.4125) @db.Decimal(10, 6)
  images           Json?     @default("[]")
  video_url        String?
  seat_count       Int?      @default(1)
  seat_description String?   @db.VarChar(255)
  division         String?   @default("Dhaka") @db.VarChar(100)
  district         String?   @default("Dhaka") @db.VarChar(100)
  bachelor_type    String?   @default("male") @db.VarChar(50)
  preferred_tenant String?   @default("Student / Job holder") @db.VarChar(100)
  facilities       Json?     @default("[]")
  is_available     Boolean?  @default(true)
  is_published     Boolean?  @default(true)
  payment_status   String?   @default("approved") @db.VarChar(50)
  payment_trx_id   String?   @db.VarChar(100)
  sender_number    String?   @db.VarChar(20)
  owner_phone      String?   @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users?    @relation(fields: [owner_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_available, is_published, created_at(sort: Desc)], map: "idx_posts_active")
  @@index([owner_uid], map: "idx_posts_owner")
}

model products {
  product_id  Int       @id @default(autoincrement())
  seller_uid  String?   @db.VarChar(255)
  title       String    @db.VarChar(255)
  description String?
  price       Decimal   @db.Decimal(10, 2)
  condition   String?   @default("used") @db.VarChar(50)
  category    String?   @default("Others") @db.VarChar(100)
  images      Json?     @default("[]")
  division    String?   @default("Dhaka") @db.VarChar(100)
  district    String?   @default("Dhaka") @db.VarChar(100)
  status      String?   @default("active") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  video_url   String?
  users       users?    @relation(fields: [seller_uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "idx_products_active")
  @@index([seller_uid], map: "idx_products_seller")
}

model reports {
  id           Int       @id @default(autoincrement())
  reporter_uid String    @db.VarChar(255)
  post_id      String    @db.VarChar(255)
  reason       String
  details      String?
  status       String?   @default("pending") @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

model users {
  uid                                   String     @id @db.VarChar(255)
  name                                  String     @db.VarChar(255)
  phone                                 String?    @unique @db.VarChar(20)
  email                                 String?    @unique @db.VarChar(255)
  gender                                String?    @db.VarChar(20)
  role                                  String?    @default("bachelor") @db.VarChar(50)
  status                                String?    @default("active") @db.VarChar(50)
  fcm_token                             String?    @db.VarChar(255)
  profile_image                         String?
  created_at                            DateTime?  @default(now()) @db.Timestamp(6)
  updated_at                            DateTime?  @default(now()) @db.Timestamp(6)
  password                              String?    @db.VarChar(255)
  google_id                             String?    @db.VarChar(255)
  bookings_bookings_bachelor_uidTousers bookings[] @relation("bookings_bachelor_uidTousers")
  bookings_bookings_landlord_uidTousers bookings[] @relation("bookings_landlord_uidTousers")
  chats_chats_user1_uidTousers          chats[]    @relation("chats_user1_uidTousers")
  chats_chats_user2_uidTousers          chats[]    @relation("chats_user2_uidTousers")
  messages                              messages[]
  payments                              payments[]
  posts                                 posts[]
  products                              products[]
}
